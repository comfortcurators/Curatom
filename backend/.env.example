# Curatom Enterprise — backend configuration template.
#
# Copy to .env for local development. .gitignore excludes .env and .env.*
# (with .env.example explicitly re-included), so this template is tracked and
# your real values are not.
#
# In deployed environments do NOT use a .env file. deploy.sh provisions
# JWT_SECRET, DEMO_PASSWORD, and API_KEY through Google Secret Manager and
# mounts them with --set-secrets.
#
# The application fails closed on startup if PROJECT_ID, API_KEY, or a
# non-default JWT_SECRET is missing. That is deliberate — a service that
# boots without them would be running with no real auth.

# Google Cloud project holding Firestore. Required.
PROJECT_ID=your-gcp-project

# Region for Cloud Run and Vertex AI. Required.
LOCATION=us-central1

# Gemini API key. Required. Never commit a real value.
API_KEY=your-gemini-api-key

# Session token signing secret. Required, and must not be a default value.
# Generate with: openssl rand -base64 48
# Keep it stable across restarts — rotating it invalidates every live session.
JWT_SECRET=generate-me-do-not-ship-this-literal

# Demo login for controlled evaluation. This is NOT production identity —
# see HARDENING_STATUS.md item 1.
# Generate the password with: openssl rand -base64 32
DEMO_USERNAME=admin
DEMO_PASSWORD=generate-me-do-not-ship-this-literal

# Exact frontend origin permitted by CORS. Leave unset locally to allow
# localhost origins; set it in any deployed environment. If unset in
# production, no browser origin is admitted — by design.
FRONTEND_URL_PRODUCTION=

# Local development only: point the Firestore client at an emulator instead
# of a real project, so tests never touch live data. Leave unset when
# deployed.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
